* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: #071b16;
  color: white;
  font-family: Arial, sans-serif;
}

header {
  background: #102820;
  padding: 22px;
  text-align: center;
  border-bottom: 2px solid #b7f36b;
}

.logo {
  font-size: 25px;
  font-weight: bold;
  color: #b7f36b;
}

header p {
  margin-top: 7px;
  color: #ccc;
}

nav {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  padding: 15px;
  background: #102820;
}

button {
  padding: 11px 16px;
  border: none;
  border-radius: 8px;
  background: #b7f36b;
  color: #102820;
  font-weight: bold;
  cursor: pointer;
}

button:hover {
  background: white;
}

main {
  max-width: 1100px;
  margin: auto;
  padding: 20px;
}

.hero {
  background: linear-gradient(120deg, #164b32, #102820);
  padding: 45px 25px;
  border-radius: 15px;
  margin-bottom: 30px;
}

.hero h1 {
  color: #b7f36b;
  font-size: 32px;
  margin-bottom: 12px;
}

.hero p {
  margin-bottom: 20px;
}

h1, h2 {
  margin-bottom: 18px;
}

h2 {
  margin-top: 28px;
}

.grid {
  display: grid;
  grid-template-columns:
    repeat(auto-fit, minmax(190px, 1fr));
  gap: 15px;
}

.card {
  background: #16352b;
  padding: 20px;
  border-radius: 12px;
  border: 1px solid #315544;
  transition: 0.2s;
}

.card:hover {
  transform: translateY(-4px);
  border-color: #b7f36b;
}

.card h3 {
  color: #b7f36b;
  margin-bottom: 10px;
}

.card p {
  color: #ddd;
  line-height: 1.6;
}

.match {
  background: #16352b;
  padding: 17px;
  margin-bottom: 12px;
  border-radius: 10px;
  text-align: center;
  border: 1px solid #315544;
}

.match h3 {
  margin-bottom: 10px;
}

.match p {
  color: #b7f36b;
  margin-top: 8px;
}

input {
  width: 100%;
  padding: 14px;
  margin: 10px 0 20px;
  border: 1px solid #315544;
  border-radius: 8px;
  background: #16352b;
  color: white;
  outline: none;
}

input::placeholder {
  color: #aaa;
}

.page {
  min-height: 350px;
}

.hidden {
  display: none;
}

footer {
  margin-top: 50px;
  padding: 30px;
  background: #102820;
  text-align: center;
  color: #aaa;
  line-height: 2;
}

footer h3 {
  color: #b7f36b;
}

@media(max-width: 600px) {
  .hero h1 {
    font-size: 25px;
  }

  nav button {
    padding: 9px 11px;
    font-size: 12px;
  }

  main {
    padding: 13px;
  }
}
