// NAVIGASI
function showPage(id) {
  document.querySelectorAll(".page").forEach(page => {
    page.classList.add("hidden");
  });

  document.getElementById(id).classList.remove("hidden");
  window.scrollTo(0, 0);
}

// TAMPILKAN LIGA
function renderLiga() {
  const cari = document
    .getElementById("cariLiga")
    ?.value.toLowerCase() || "";

  const hasil = liga.filter(item =>
    item[1].toLowerCase().includes(cari)
  );

  const html = hasil.map(item => `
    <div class="card">
      <h3>${item[0]} ${item[1]}</h3>
      <p>Wilayah: ${item[2]}</p>
    </div>
  `).join("");

  document.getElementById("ligaList").innerHTML =
    html || "<p>Liga tidak ditemukan.</p>";
}

// TAMPILKAN JADWAL
function renderJadwal() {
  const cari = document
    .getElementById("cariJadwal")
    ?.value.toLowerCase() || "";

  const hasil = jadwal.filter(item =>
    (item.home + item.away + item.liga)
      .toLowerCase().includes(cari)
  );

  document.getElementById("jadwalList").innerHTML =
    hasil.map(item => `
      <div class="match">
        <h3>${item.home} ⚽ ${item.away}</h3>
        <p>${item.liga}</p>
        <p>${item.tanggal} • ${item.waktu}</p>
      </div>
    `).join("") || "<p>Jadwal tidak ditemukan.</p>";
}

// TAMPILKAN NEGARA
function renderTim() {
  document.getElementById("timList").innerHTML =
    negara.map(item => `
      <div class="card">
        <h3>${item[0]} ${item[1]}</h3>
        <p>Informasi sepak bola ${item[1]}.</p>
      </div>
    `).join("");
}

// TAMPILKAN PEMAIN
function renderPemain() {
  const cari = document
    .getElementById("cariPemain")
    ?.value.toLowerCase() || "";

  const hasil = pemain.filter(item =>
    item.join(" ").toLowerCase().includes(cari)
  );

  document.getElementById("pemainList").innerHTML =
    hasil.map(item => `
      <div class="card">
        <h3>⚽ ${item[0]}</h3>
        <p>${item[1]} ${item[3]}</p>
        <p>Posisi: ${item[2]}</p>
      </div>
    `).join("") || "<p>Pemain tidak ditemukan.</p>";
}

